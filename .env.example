# Environment
NODE_ENV=development
PORT=3000

# RBAC Secret — used to sign/verify bearer tokens
API_SECRET=change-me-in-production

# Webhook endpoint for quarantine module (Module 1: CNHS)
QUARANTINE_WEBHOOK_URL=http://localhost:3000/api/v1/quarantine/ingest

# TIPS Worker
TIPS_CRON_EXPRESSION=*/1 * * * *
TIPS_LOOKAHEAD_MINUTES=60

# Logging
LOG_LEVEL=debug
